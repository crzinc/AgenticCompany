# Supabase (бесплатно - https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Next.js Frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend
BACKEND_URL=http://localhost:8000

# Бесплатные LLM API (выберите один)

# 1. HuggingFace (бесплатно) - https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_token

# 2. Groq (бесплатно, быстро) - https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# 3. Google Gemini (бесплатно) - https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key

# Company Settings
COMPANY_NAME=AgenticCompany